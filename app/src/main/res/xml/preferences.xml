<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:seekbar="http://schemas.moonlight-stream.com/apk/res/seekbar">

    <PreferenceCategory android:title="@string/category_basic_settings"
        android:key="category_basic_settings">
        <ListPreference
            android:key="list_resolution"
            android:title="@string/title_resolution_list"
            android:summary="@string/summary_resolution_list"
            android:entries="@array/resolution_names"
            android:entryValues="@array/resolution_values"
            android:defaultValue="1920x1080" />
        <ListPreference
            android:key="list_fps"
            android:title="@string/title_fps_list"
            android:summary="@string/summary_fps_list"
            android:entries="@array/fps_names"
            android:entryValues="@array/fps_values"
            android:defaultValue="60" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_bitrate_kbps"
            android:dialogMessage="@string/summary_seekbar_bitrate"
            seekbar:min="500"
            android:max="99999000"
            seekbar:step="500"
            seekbar:keyStep="1000"
            seekbar:divisor="1000"
            android:summary="@string/summary_seekbar_bitrate"
            android:text="@string/suffix_seekbar_bitrate_mbps"
            android:title="@string/title_seekbar_bitrate" />

        <EditTextPreference
            android:key="edit_diy_bitrate"
            android:defaultValue="20"
            android:singleLine="true"
            android:dialogTitle="Enter Video Bitrate (Mbps)"
            android:summary="Manually input video bitrate instead of using the slider.\nValues exceeding slider maximum still take effect during stream."
            android:dialogMessage="Enter a number (supports .5 increments)"
            android:title="Force Custom Video Bitrate" />

        <Preference
            android:key="vdValue"
            android:persistent="false"
            android:title="@string/title_virtual_display"
            android:summary="@string/summary_virtual_display" />

        <ListPreference
            android:key="frame_pacing"
            android:title="@string/title_frame_pacing"
            android:entries="@array/video_frame_pacing_names"
            android:entryValues="@array/video_frame_pacing_values"
            android:summary="@string/summary_frame_pacing"
            android:defaultValue="latency" />

        <CheckBoxPreference
            android:key="enable_lowLatency_experiment"
            android:title="Low Latency Decoder Optimization (Beta)"
            android:summary="(Experimental) Effective for Snapdragon 8 Gen 1+ and Dimensity 9300 and below."
            android:defaultValue="true" />

        <CheckBoxPreference
            android:key="checkbox_enable_xiaomi_xring_o1_optimization"
            android:title="Xiaomi Xuanjie O1 Optimization"
            android:summary="Applies dedicated low latency decoder compatibility optimization for Xiaomi Xuanjie O1."
            android:defaultValue="false" />

        <ListPreference
            android:key="list_video_render_mode"
            android:title="Render Mode"
            android:entries="@array/video_render_mode_names"
            android:entryValues="@array/video_render_mode_values"
            android:summary="GLES rendering supports FSR and post-processing features."
            android:defaultValue="system" />

        <ListPreference
            android:key="list_stereo_3d_mode"
            android:title="3D Output"
            android:entries="@array/stereo_3d_mode_names"
            android:entryValues="@array/stereo_3d_mode_values"
            android:summary="Full SBS outputs 3840x1080/1200, Half SBS outputs 1920x1080/1200 (GLES only)."
            android:defaultValue="off" />

        <ListPreference
            android:key="list_stereo_3d_depth"
            android:title="3D Depth"
            android:entries="@array/stereo_3d_depth_names"
            android:entryValues="@array/stereo_3d_depth_values"
            android:summary="Controls stereo parallax. Recommended to start with Standard."
            android:defaultValue="standard" />

        <ListPreference
            android:key="list_stereo_3d_convergence"
            android:title="3D Convergence"
            android:entries="@array/stereo_3d_convergence_names"
            android:entryValues="@array/stereo_3d_convergence_values"
            android:summary="Adjusts screen plane convergence depth."
            android:defaultValue="standard" />

        <CheckBoxPreference
            android:key="checkbox_stereo_3d_swap_eyes"
            android:title="Swap Left/Right Eye"
            android:summary="Enable if 3D glasses eye order is inverted."
            android:defaultValue="false" />

        <ListPreference
            android:key="list_fsr_target"
            android:title="Upscaling Target"
            android:entries="@array/fsr_target_names"
            android:entryValues="@array/fsr_target_values"
            android:summary="Enable FSR upscaling to 2K or 4K under GLES rendering."
            android:defaultValue="off" />

        <ListPreference
            android:key="list_fsr_sharpness"
            android:dependency="list_fsr_target"
            android:title="Sharpness Strength"
            android:entries="@array/fsr_sharpness_names"
            android:entryValues="@array/fsr_sharpness_values"
            android:summary="Effective when FSR is enabled. Higher values produce sharper edges."
            android:defaultValue="standard" />

        <ListPreference
            android:key="list_fsr_hdr_output"
            android:dependency="list_fsr_target"
            android:title="FSR HDR Output"
            android:entries="@array/fsr_hdr_output_names"
            android:entryValues="@array/fsr_hdr_output_values"
            android:summary="Compatible SDR Tone Mapping is more stable; Native HDR Output requires BT2020 PQ support."
            android:defaultValue="native" />
        <CheckBoxPreference
            android:key="checkbox_stretch_video"
            android:title="@string/title_checkbox_stretch_video"
            android:defaultValue="false" />

        <CheckBoxPreference
            android:key="checkbox_cutout_mode_video"
            android:title="Fill Display Cutout / Notch Area"
            android:defaultValue="false" />

        <CheckBoxPreference
            android:key="checkbox_auto_screen_orientation"
            android:title="Auto-Rotate Screen Orientation"
            android:defaultValue="false" />

        <ListPreference
            android:key="screen_gravity_list"
            android:title="画面显示位置"
            android:summary="Aligns video stream on foldable devices or tablets with custom resolutions."
            android:entries="@array/screen_gravity_list_names"
            android:entryValues="@array/screen_gravity_list_values"
            android:defaultValue="0" />

        <CheckBoxPreference
            android:key="checkbox_ui_theme_white"
            android:title="Light Theme for Certain Pages"
            android:summary="Effective on Android 10+"
            android:defaultValue="true" />

    </PreferenceCategory>
    <PreferenceCategory android:title="@string/category_audio_settings"
        android:key="category_audio_settings">
        <ListPreference
            android:key="list_audio_config"
            android:title="@string/title_audio_config_list"
            android:summary="@string/summary_audio_config_list"
            android:entries="@array/audio_config_names"
            android:entryValues="@array/audio_config_values"
            android:defaultValue="2" />
        <CheckBoxPreference
            android:key="checkbox_enable_audiofx"
            android:title="@string/title_checkbox_enable_audiofx"
            android:summary="@string/summary_checkbox_enable_audiofx"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/category_gamepad_settings"
        android:key="category_gamepad_settings">
        <CheckBoxPreference
            android:key="checkbox_usbip_mode"
            android:title="@string/title_usbip_mode"
            android:summary="@string/summary_usbip_mode"
            android:defaultValue="false" />
        <ListPreference
            android:key="list_gamepad_emulation"
            android:title="@string/title_gamepad_emulation"
            android:summary="@string/summary_gamepad_emulation"
            android:entries="@array/gamepad_emulation_names"
            android:entryValues="@array/gamepad_emulation_values"
            android:defaultValue="auto" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_deadzone"
            android:defaultValue="7"
            android:max="50"
            android:summary="@string/summary_seekbar_deadzone"
            android:text="@string/suffix_seekbar_deadzone"
            android:title="@string/title_seekbar_deadzone"/>
        <CheckBoxPreference
            android:key="checkbox_multi_controller"
            android:title="@string/title_checkbox_multi_controller"
            android:summary="@string/summary_checkbox_multi_controller"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="checkbox_usb_driver"
            android:title="@string/title_checkbox_xb1_driver"
            android:summary="@string/summary_checkbox_xb1_driver"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="checkbox_usb_bind_all"
            android:dependency="checkbox_usb_driver"
            android:title="@string/title_checkbox_usb_bind_all"
            android:summary="@string/summary_checkbox_usb_bind_all"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_mouse_emulation"
            android:title="@string/title_checkbox_mouse_emulation"
            android:summary="@string/summary_checkbox_mouse_emulation"
            android:defaultValue="true" />

        <ListPreference
            android:key="analog_scrolling"
            android:dependency="checkbox_mouse_emulation"
            android:title="@string/title_analog_scrolling"
            android:summary="@string/summary_analog_scrolling"
            android:entries="@array/analog_scrolling_names"
            android:entryValues="@array/analog_scrolling_values"
            android:defaultValue="right" />
        <CheckBoxPreference
            android:key="checkbox_vibrate_fallback"
            android:title="@string/title_checkbox_vibrate_fallback"
            android:summary="@string/summary_checkbox_vibrate_fallback"
            android:defaultValue="false" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_vibrate_fallback_strength"
            android:dependency="checkbox_vibrate_fallback"
            android:defaultValue="100"
            android:max="200"
            android:summary="@string/summary_seekbar_vibrate_fallback_strength"
            android:text="@string/suffix_seekbar_vibrate_fallback_strength"
            android:title="@string/title_seekbar_vibrate_fallback_strength"/>
        <CheckBoxPreference
            android:key="checkbox_flip_face_buttons"
            android:title="@string/title_checkbox_flip_face_buttons"
            android:summary="@string/summary_checkbox_flip_face_buttons"
            android:defaultValue="false" />

        <CheckBoxPreference
            android:key="checkbox_flip_rumble_ff"
            android:title="Invert Grip Rumble Motors"
            android:summary="Inverts left/right rumble motors if trigger haptics are reversed."
            android:defaultValue="false" />

        <CheckBoxPreference
            android:key="checkbox_gamepad_touchpad_as_mouse"
            android:title="@string/title_checkbox_gamepad_touchpad_as_mouse"
            android:summary="@string/summary_checkbox_gamepad_touchpad_as_mouse"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_gamepad_motion_sensors"
            android:title="@string/title_checkbox_gamepad_motion_sensors"
            android:summary="@string/summary_checkbox_gamepad_motion_sensors"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="checkbox_gamepad_motion_fallback"
            android:title="@string/title_checkbox_gamepad_motion_fallback"
            android:summary="@string/summary_checkbox_gamepad_motion_fallback"
            android:defaultValue="false" />

        <CheckBoxPreference
            android:key="checkbox_disable_trigger_deadzone"
            android:title="Disable Default 13% Trigger Deadzone"
            android:summary="Removes default trigger deadzone clamping (except certain ASUS gamepads)."
            android:defaultValue="false"/>

    </PreferenceCategory>
