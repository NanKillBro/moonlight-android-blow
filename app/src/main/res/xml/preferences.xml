        <CheckBoxPreference
            android:key="checkbox_enable_virtual_motion"
            android:title="Virtual Gamepad Gyroscope"
            android:summary="Enables phone gyro for virtual gamepad motion controls.\n(May require configuring Sunshine controller type as PS4 controller)"
            android:defaultValue="false"/>

        <CheckBoxPreference
            android:key="checkbox_enable_clear_default_special_button"
