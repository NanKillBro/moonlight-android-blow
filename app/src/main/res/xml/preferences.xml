        <Preference
            android:key="import_switch_button_file"
            android:title="Import Custom Accessibility Config"
            android:summary="Overwrites current accessibility config file. Please backup before importing."
            />

        <CheckBoxPreference
            android:key="checkbox_enable_accessibility_show_log"
            android:title="Show Captured Keycodes in Accessibility Mode"
            android:summary="Displays keycode toast when pressing keys in accessibility keyboard mode."
            android:defaultValue="false"/>

    </PreferenceCategory>


    <PreferenceCategory android:title="Virtual Controls"
        android:key="category_axixi_settings">

        <CheckBoxPreference
            android:key="checkbox_enable_keyboard"
