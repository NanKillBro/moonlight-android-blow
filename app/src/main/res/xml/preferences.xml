    <PreferenceCategory android:title="Custom Fork Settings"
        android:key="category_axixi_settings">

        <EditTextPreference
            android:key="edit_diy_w_h"
            android:defaultValue="1920x1080"
            android:singleLine="true"
            android:dialogTitle="After setting resolution, re-enter settings to apply!"
            android:summary="Add a custom resolution formatted as WxH (e.g. 1920x1080).\nNon-standard resolutions may not fill notch areas by default;\nstretch to full screen can be enabled if aspect ratios match."
            android:title="Custom Resolution" />

