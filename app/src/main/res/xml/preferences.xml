            android:defaultValue="OSC_Keyboard" />

        <CheckBoxPreference
            android:key="checkbox_vibrate_keyboard"
            android:title="@string/title_checkbox_vibrate_osc"
            android:summary="Vibrate phone when pressing on-screen controls."
            android:defaultValue="false" />

        <Preference
            android:key="import_keyboard_file"
            android:title="Import Virtual Controls Preset"
            android:summary="Select a configuration file to overwrite the selected layout preset. (Landscape only)"
            />

        <Preference
            android:key="export_keyboard_file"
            android:title="Export Virtual Controls Preset"
            android:summary="Export configuration file for the selected layout preset. (Landscape only)"
            />

    </PreferenceCategory>

    <PreferenceCategory android:title="Audio Haptics (Beta)"
        android:key="category_axixi_audio_rumble">
        <CheckBoxPreference
            android:key="checkbox_enable_audio_haptics"
            android:title="Enable Audio Haptics"
            android:summary="Converts streaming audio to haptic rumble for explosions, impacts, and bass effects."
            android:defaultValue="false" />
        <ListPreference
            android:key="list_audio_haptics_output_target"
            android:dependency="checkbox_enable_audio_haptics"
            android:title="Audio Haptics Output Target"
            android:summary="Output haptics to phone motor or connected gamepad."
            android:entries="@array/audio_haptics_output_target_names"
            android:entryValues="@array/audio_haptics_output_target_values"
            android:defaultValue="phone" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_audio_haptics_strength"
            android:dependency="checkbox_enable_audio_haptics"
            android:defaultValue="100"
            seekbar:min="25"
            seekbar:step="5"
            seekbar:keyStep="5"
            android:max="200"
            android:summary="Adjust audio haptics vibration strength."
            android:text="%"
            android:title="Audio Haptics Strength" />
        <ListPreference
            android:key="list_audio_haptics_voice_filter"
            android:dependency="checkbox_enable_audio_haptics"
            android:title="Voice Filter"
            android:summary="Reduces rumble triggered by voice chat and dialogues."
            android:entries="@array/audio_haptics_voice_filter_names"
            android:entryValues="@array/audio_haptics_voice_filter_values"
            android:defaultValue="off" />
        <CheckBoxPreference
            android:key="checkbox_audio_haptics_keep_controller_rumble"
            android:dependency="checkbox_enable_audio_haptics"
            android:title="Keep Standard Gamepad Rumble"
            android:summary="Retain native game rumble when haptics output target is set to gamepad."
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pairing_backup_category"
        android:key="category_axixi_back_data">

        <Preference
            android:key="export_pairing_backup"
            android:title="@string/pairing_backup_export"
            android:summary="@string/pairing_backup_export_summary" />

        <Preference
            android:key="import_pairing_backup"
            android:title="@string/pairing_backup_import"
            android:summary="@string/pairing_backup_import_summary" />

    </PreferenceCategory>

    <PreferenceCategory android:title="Home Screen Settings"
        android:key="category_axixi_screen">

        <CheckBoxPreference
            android:key="checkbox_enable_screen_bg"
            android:title="Use Custom Background Image"
            android:summary="Use custom wallpaper on home screen (Android 10+)"
            android:defaultValue="false" />

        <Preference
            android:key="import_image_file_key"
            android:title="Set Home Screen Background"
            android:summary="Choose an image for home screen wallpaper.\n(Rotate screen or restart app to apply)"
            />

        <CheckBoxPreference
            android:key="checkbox_enable_screen_obscure"
            android:title="Background Gaussian Blur"
            android:summary="Apply Gaussian blur to custom wallpaper (Android 12+)"
            android:defaultValue="true" />

        <EditTextPreference
            android:key="change_screen_label_key"
            android:defaultValue="@string/app_label"
            android:singleLine="true"
            android:dialogTitle="Set Home Screen Title Text"
            android:summary="Custom title text displayed on home screen"
            android:dialogMessage="Enter title text for home screen"
            android:title="Home Screen Title Text" />

        <CheckBoxPreference
            android:key="checkbox_enable_pass_menu"
            android:title="Direct Launch App (Skip Menu)"
            android:summary="Directly launch stream when clicking an app icon without opening popup menu."
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="About"
        android:key="category_axi_about">

        <com.limelight.preferences.WebLauncherPreference
            android:key="settings_about"
            android:title="About"
            android:summary="Version info, updates, and credits"
            url="about"/>

        <com.limelight.preferences.WebLauncherPreference
            android:key="settings_help"
            android:title="Moonlight Setup Guide"
            android:summary="Official documentation and guides"
            url="https://github.com/moonlight-stream/moonlight-docs/wiki/Setup-Guide"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_stream_logs"
        android:title="Stream Logs">

        <CheckBoxPreference
            android:key="checkbox_enable_stream_session_logging"
            android:title="Stream Log Collection"
            android:summary="Generates session logs recording connection, video, network, gamepad, and crash events."
            android:defaultValue="false" />

        <Preference
            android:key="manage_stream_session_logs"
            android:title="Log File List"
            android:summary="View, export, or delete saved stream logs" />

    </PreferenceCategory>


    <!-- Additional persistent controls also available through the in-stream quick menu. -->
    <PreferenceCategory android:key="category_settings_additional" android:title="其他配置">
        <CheckBoxPreference
            android:key="checkbox_enable_hdr_high_brightness"
            android:title="HDR 高亮度"
            android:summary="在支持的设备上提高 HDR 画面亮度"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_enforce_display_mode"
            android:title="强制显示模式"
            android:summary="优先使用匹配串流帧率的显示模式；显示异常时可关闭"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_keep_video_zoom_on_disable"
            android:title="保留画面缩放"
            android:summary="关闭缩放调节时保留已调整的画面比例"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_keyboard_esc_opens_game_menu"
            android:title="Esc 打开游戏菜单"
            android:summary="使用实体键盘 Esc 键打开串流快捷菜单"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_ds5_native_pcm"
            android:title="DualSense 原生音频震动"
            android:summary="接收支持的主机发送的原生 PCM 触觉数据"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="checkbox_ds5_controller_speaker"
            android:title="DualSense 手柄扬声器"
            android:summary="向支持的 DualSense 手柄输出游戏扬声器音频"
            android:defaultValue="false" />
    </PreferenceCategory>

