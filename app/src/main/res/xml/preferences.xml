        <CheckBoxPreference
            android:key="checkbox_enable_exdisplay"
            android:title="External Display Mode (Beta)"
            android:summary="Streams video to external display while showing virtual controls and overlay on phone screen."
            android:defaultValue="false"/>

        <CheckBoxPreference
            android:key="checkbox_enable_device_rumble"
            android:title="Force Device Vibration Motor"
            android:summary="Uses the phone vibration motor for game rumble instead of the connected controller."
